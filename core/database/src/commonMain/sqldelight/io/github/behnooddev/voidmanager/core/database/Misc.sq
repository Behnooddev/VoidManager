CREATE TABLE tag (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL UNIQUE,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE entity_tag (
  entity_id TEXT NOT NULL REFERENCES entity (id) ON DELETE CASCADE,
  tag_id TEXT NOT NULL REFERENCES tag (id) ON DELETE CASCADE,
  PRIMARY KEY (entity_id, tag_id)
);

CREATE TABLE person_group (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL UNIQUE,
  sort_order INTEGER NOT NULL DEFAULT 0,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE entity_group (
  entity_id TEXT NOT NULL REFERENCES entity (id) ON DELETE CASCADE,
  group_id TEXT NOT NULL REFERENCES person_group (id) ON DELETE CASCADE,
  PRIMARY KEY (entity_id, group_id)
);

CREATE TABLE media_asset (
  id TEXT NOT NULL PRIMARY KEY,
  entity_id TEXT NOT NULL REFERENCES entity (id) ON DELETE CASCADE,
  kind INTEGER NOT NULL CHECK (kind IN (0, 1, 2)),
  file_ref TEXT NOT NULL,
  mime TEXT NOT NULL,
  size_bytes INTEGER NOT NULL CHECK (size_bytes >= 0),
  sha256 TEXT NOT NULL,
  title TEXT,
  note TEXT,
  taken_at INTEGER,
  sensitivity INTEGER NOT NULL DEFAULT 1 CHECK (sensitivity BETWEEN 0 AND 3),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE INDEX media_asset_entity ON media_asset (entity_id, kind);

CREATE TABLE share_origin (
  entity_id TEXT NOT NULL PRIMARY KEY REFERENCES entity (id) ON DELETE CASCADE,
  source_key_id TEXT,
  source_entity_id TEXT NOT NULL,
  last_received_at INTEGER NOT NULL
);

CREATE TABLE vault_meta (
  key TEXT NOT NULL PRIMARY KEY,
  value TEXT NOT NULL
);

getMeta:
SELECT value FROM vault_meta WHERE key = :key;

putMeta:
INSERT INTO vault_meta (key, value) VALUES (:key, :value)
ON CONFLICT (key) DO UPDATE SET value = excluded.value;
